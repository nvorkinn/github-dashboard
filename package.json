    "marked": "18.2.0",
    "material-icon-theme": "5.40.0",
    "preact": "11.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "26.6.6",
    "happy-dom": "21.0.4",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0",
